# AgriSense - Environment Configuration Example
# Copy this file to .env and customize with your local configuration

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Relational Database (MySQL 8.0+)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=agrisense_db

# NoSQL Database (MongoDB 6.0+)
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=agrisense_nosql

# Fallback Configuration
# If True, AgriSense will gracefully fall back to local cached synthetic data 
# if database servers are temporarily unreachable, allowing offline exploration.
ALLOW_LOCAL_FALLBACK=true
